# Dependencies — reinstall with `npm install` (see package.json / package-lock.json)
node_modules/

# Agent tool scratch output (sprite runs, QA renders, validation dumps)
.pet-runs/

# Generated lecture decks. A .pptx is a zip, so git cannot delta-compress it —
# every rebuild would store a complete new copy. Rebuild with
# `python pipeline/build_chapter_deck.py <n>`; attach decks to a GitHub Release
# when a citable snapshot is needed. Seeds (pipeline/slides/) and slide assets
# (slides/) ARE committed; only the build output is ignored.
build/

# Word/Office lock files — this repo carries many .docx line-edit packets
~$*.doc*
~$*.xls*
~$*.ppt*

# OS cruft
Thumbs.db
desktop.ini
.DS_Store

# npm logs
npm-debug.log*

# Superseded/duplicate figure drafts and cover-art exploration — archived outside
# git at C:\Users\oxfor\OneDrive\z Teaching\zzz Psych101_archive, not the published site.
docs/images/**/*not used*/
docs/images/**/unused/
docs/images/**/candidates/
docs/images/**/replaced*/
docs/images/**/Alternatives/
docs/images/**/*_polished_draft_assets/
/Images for Cover/

# Pre-publication image staging area (Jon's holding pen for unmatched chapters) —
# archived outside git; mine it from the OneDrive copy when starting a new chapter's figures.
/Potential Images for Chapters Holding Space/
